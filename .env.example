# NetSuite MCP Server - Environment Configuration Example
# Copy this file to .env.sb1 or .env.sb2 and fill in your actual credentials

# ============================================================================
# SANDBOX 1 ENVIRONMENT (sb1)
# ============================================================================

# Your NetSuite Account ID (e.g., 1234567_SB1 for sandbox, 1234567 for production)
NETSUITE_SB1_ACCOUNT_ID=1234567_SB1

# Client ID from the Integration Record
# (Setup > Integration > Manage Integrations > Your Integration > Client ID)
NETSUITE_SB1_CLIENT_ID=your-client-id-here

# Certificate ID from OAuth 2.0 Client Credentials Setup
# (Setup > Integration > OAuth 2.0 Client Credentials (M2M) Setup)
NETSUITE_SB1_CERTIFICATE_ID=your-certificate-id-here

# Private Key (PEM format) - Keep the line breaks as \n
# Generate with: openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
#   -keyout private_key.pem -out certificate.pem -days 365 -nodes \
#   -subj "/CN=mcp-netsuite"
NETSUITE_SB1_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----

# ============================================================================
# SANDBOX 2 ENVIRONMENT (sb2) - Optional
# ============================================================================

# NETSUITE_SB2_ACCOUNT_ID=1234567_SB2
# NETSUITE_SB2_CLIENT_ID=your-client-id-here
# NETSUITE_SB2_CERTIFICATE_ID=your-certificate-id-here
# NETSUITE_SB2_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----

# ============================================================================
# DEFAULT ENVIRONMENT
# ============================================================================

# Which environment to use by default (sb1 or sb2)
# If not set, the first environment with complete credentials will be used
NETSUITE_DEFAULT_ENV=sb1

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Only environments with all four credentials (ACCOUNT_ID, CLIENT_ID,
#    CERTIFICATE_ID, PRIVATE_KEY) will be registered
#
# 2. To convert a PEM file to a single-line format for use here:
#    awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private_key.pem
#
# 3. For MCP client configuration (.claude.json or .cursor/mcp.json):
#    - Use the absolute path to dist/index.js
#    - Include all environment variables in the "env" section
#    - The private key should be on a single line with \n for line breaks
#
# 4. Keep this file secure and never commit it to version control!
#    The .gitignore file already excludes .env and .env.* files
